# ---------------------------------------------------------------------------
# HireReady AI environment variables. Copy to backend/.env and frontend/.env.local.
# NEVER commit real values. Only NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# ===== Backend (FastAPI) =====
APP_ENV=development                 # development | production
APP_BASE_URL=http://localhost:3000  # public frontend URL (used in email links)
ALLOWED_ORIGINS=http://localhost:3000

# Groq: verify current ids at https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Google Gemini (fallback LLM + embeddings)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Supabase (service role key is backend-only!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis REST API (Phase 7): shared per-IP rate limits + the global daily LLM budget.
# Empty = in-process counters per serverless instance (fine locally, weaker on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (Phase 7): bot check on POST /sessions. Set together with
# NEXT_PUBLIC_TURNSTILE_SITE_KEY below (secret alone = every session creation gets 403).
TURNSTILE_SECRET_KEY=

# Email via Resend (Phase 5). Leave empty to disable "Email me this report" (the button is
# shown disabled with an explanation). EMAIL_FROM must be on a domain verified in Resend,
# e.g. "HireReady AI <reports@yourdomain.com>" (onboarding@resend.dev only mails your own address).
RESEND_API_KEY=
EMAIL_FROM=

# Automation (Phase 7)
# Standard Webhooks "report.completed" event (e.g. n8n). https:// only; secret like whsec_<base64>.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Empty = cron endpoints answer 503.
CRON_SECRET=
# Signs reminder links (confirm / mark done / unsubscribe). Empty = no prep reminders.
REMINDER_TOKEN_SECRET=
REMINDER_DAILY_CAP=250              # max reminder emails per daily run (below the email quota)
# Global daily LLM-call budget (all users). Demo pauses at RATIO x budget; everything at 100%.
LLM_DAILY_BUDGET=1500
LLM_DAILY_SOFT_RATIO=0.8
# Shared with the frontend proxy (frontend/proxy.ts) so the backend can trust the browser IP it
# forwards. Same random value on BOTH projects; empty = use the platform headers.
CLIENT_IP_HEADER_SECRET=

# Langfuse tracing, optional (Phase 8). Off unless ALL three are set. Spans carry metadata only
# (step, model, tokens, latency, request id), never CV/JD/transcript text. See backend/app/core/tracing.py.
LANGFUSE_PUBLIC_KEY=                # pk-lf-...
LANGFUSE_SECRET_KEY=                # sk-lf-...
LANGFUSE_HOST=                      # e.g. https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com

# ===== Frontend (Next.js) =====
BACKEND_URL=http://127.0.0.1:8000   # server-side only, used by rewrites
NEXT_PUBLIC_TURNSTILE_SITE_KEY=     # the only public value; empty = no widget
# CLIENT_IP_HEADER_SECRET (same value as the backend, server-only) is read by frontend/proxy.ts.
